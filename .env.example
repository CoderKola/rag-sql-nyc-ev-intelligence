DEEPSEEK_API_KEY=
ENV=development
MONTHLY_BUDGET_CAP=9.00
BUDGET_WARNING_THRESHOLD=7.00
RATE_LIMIT_PER_HOUR=5
MAX_INPUT_CHARS=500

# Dev
PARQUET_PATH=./data/parquet/
CHROMA_PERSIST_PATH=./data/chroma
OLLAMA_BASE_URL=http://localhost:11434

# Prod
S3_DATA_BUCKET=nyc-intelligence-data
S3_CHROMA_BUCKET=nyc-intelligence-chroma
DYNAMODB_RATE_TABLE=rate_limits
DYNAMODB_USAGE_TABLE=usage_log
LAMBDA_EXECUTOR_ARN=arn:aws:lambda:us-east-1:ACCOUNT:function:nyc-chart-executor
AWS_REGION=us-east-1

# Data
DATA_THROUGH_YEAR=2024
